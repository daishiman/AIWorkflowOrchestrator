  "designDecisions": [
    {
      "id": "DD-01",
      "title": "SmartDefaultResult は string | null のまま維持",
      "rationale": "LLM推論結果として1値を返す設計が自然。LLMプロンプト変更の連鎖を回避。applySmartDefaults 内で string → [string] 変換することでコスト最小化。",
      "alternatives": [
        "SmartDefaultResult を string[] | null に変更（採用せず: バックエンド変更が連鎖）"
      ]
    },
    {
      "id": "DD-02",
      "title": "resolveExternalIntegration は selectedOptions[0] 先頭値参照",
      "rationale": "外部ツール統合は1ツールを主対象とするのが自然。複数ツール並列対応は別タスクのスコープ。",
      "alternatives": [
        "全選択値を処理（採用せず: CompleteStep・createSkill が複数値非対応）"
      ]
    }
  ],

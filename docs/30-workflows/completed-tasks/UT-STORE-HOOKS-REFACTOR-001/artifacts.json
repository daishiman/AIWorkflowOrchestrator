  "problemDescription": {
    "symptom": "設定画面がぐるぐる回り続ける、LLM/スキル選択が無限実行",
    "rootCause": "useAuthModeStore()等の合成Store Hookが毎回新しいオブジェクトを返すため、その中の関数をuseEffectの依存配列に含めると無限ループが発生",
    "solution": {
      "shortTerm": "useRefでガードし、依存配列は空にする",
      "longTerm": "個別セレクタベース（useAuthMode(), useSetAuthMode()等）に再設計"
    }
  },
  "affectedComponents": [
    "設定画面（Settings）",
    "認証方式選択（AuthModeSelector）",
    "LLM選択（LLMSelector）",
    "スキル選択（SkillSelector）"
  ]

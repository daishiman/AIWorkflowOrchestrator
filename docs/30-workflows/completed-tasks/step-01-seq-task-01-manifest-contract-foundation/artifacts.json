  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "description": "manifest が保持する範囲を phase / resource / entry-exit に限定し、非責務が明文化されている",
      "verified": true
    },
    {
      "id": "AC-2",
      "description": "schema、loader、cache invalidation の責務境界が RuntimeSkillCreatorFacade、SkillCreatorService、IPC 層と衝突しない",
      "verified": true
    },
    {
      "id": "AC-3",
      "description": "Task02 は phase topology、Task03 は resource descriptor、Task04 は entry-exit hook を追加解釈なしで受け取れる",
      "verified": true
    },
    {
      "id": "AC-4",
      "description": "現行コード anchor と aiworkflow-requirements の参照先が 1:1 で対応付けられている",
      "verified": true
    }
  ],
  "concerns": [
    {
      "id": "A",
      "name": "scope / non-scope 契約",
      "description": "manifest が吸収する変更とコード修正が必要な変更を分ける"
    },
    {
      "id": "B",
      "name": "schema / loader / cache 境界",
      "description": "file schema、loader lifecycle、cache invalidation を定義する"
    },
    {
      "id": "C",
      "name": "downstream handoff",
      "description": "Task02、Task03、Task04 が消費する入力契約を固定する"
    }
  ],

  "acceptanceCriteria": [
    "AC-1: 並列ブランチが LOGS.md を更新してもマージコンフリクトが発生しない（git merge テストで検証）",
    "AC-2: EVALS.json が並列マージで破損せず、意図せず新しい状態値を失わない（jq . EVALS.json で JSON 構造が有効であること）",
    "AC-3: .claude/** のみを変更した PR は CI をスキップして即マージ可能",
    "AC-4: indexes/*.json がマージ後に自動再生成され、消えた情報が復元される（post-merge フック動作確認）",
    "AC-5: SKILL.md の変更履歴部分はコンフリクトなしにマージできる",
    "AC-6: 全スキルの SKILL-changelog.md が存在し、SKILL.md から変更履歴が削除されている",
    "AC-7: gwt で新規 worktree 作成後に git rev-parse --git-path hooks/post-merge で解決される post-merge フックが自動インストールされる",
    "AC-8: B レイアウト起動時の gwt-layout-init が CLAUDE_SKIP_HEAVY_HOOKS=1 でフックをスキップして完了する"
  ],
  "subtasks": [
    {
      "id": "FIX-001-A",
      "name": "EVALS.json merge 戦略修正",
      "files": [".gitattributes"],
      "description": "merge=union → merge=ours に変更。JSON の重複キー発生を防止"
    },
    {
      "id": "FIX-001-B",
      "name": "CI 設定更新",
      "files": [".github/workflows/ci.yml"],
      "description": "paths-ignore に .claude/** / .agents/** 追加、merge_group: トリガー追加"
    },
    {
      "id": "FIX-001-C",
      "name": "post-merge インデックス再生成フック",
      "files": [
        ".claude/hooks/post-merge-index-regenerate.sh",
        ".claude/scripts/install-git-hooks.sh",
        ".claude/hooks/session-init.sh"
      ],
      "description": "マージ後に indexes/*.json を node スクリプトで自動再生成"
    },
    {
      "id": "FIX-001-D",
      "name": "SKILL.md 構造分割",
      "files": [
        ".claude/skills/*/SKILL.md",
        ".claude/skills/*/SKILL-changelog.md",
        ".agents/skills/*/SKILL.md",
        ".agents/skills/*/SKILL-changelog.md",
        ".gitattributes"
      ],
      "description": "変更履歴セクションを SKILL-changelog.md に切り出し、merge=union 設定追加"
    },
    {
      "id": "FIX-001-E",
      "name": "gwt() post-merge フック自動インストール",
      "files": ["~/.config/zsh/conf.d/73-git-worktree.zsh"],
      "description": "worktree 作成成功後に _gwt_ensure_post_merge_hook() を呼び出し、git rev-parse --git-path hooks/post-merge で解決される post-merge フックを自動設定。FIX-001-C 完了後に実施",
      "prerequisite": "FIX-001-C"
    },
    {
      "id": "FIX-001-F",
      "name": "B レイアウト重いフックスキップ",
      "files": ["~/.tmux.conf"],
      "description": "bind B の pane 1 send-keys に CLAUDE_SKIP_HEAVY_HOOKS=1 を付与し、gwt-layout-init 実行中の Claude Code 重フックを抑制",
      "prerequisite": "FIX-001-C"
    }
  ],
  "dependencies": [
    {
      "type": "prerequisite-completed",
      "description": ".gitattributes への LOGS.md / references/*.md / indexes/*.json マージ戦略追加（この会話で実施済み）"

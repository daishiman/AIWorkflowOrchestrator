{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{eventType}}.schema.json",
  "title": "{{EventName}}",
  "description": "{{Event description}}",
  "type": "object",
  "required": ["eventType", "version", "timestamp", "correlationId", "data"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance"
    },
    "eventType": {
      "const": "{{domain}}.{{aggregate}}.{{action}}",
      "description": "Event type identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semver)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event occurrence time (ISO 8601)"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Correlation ID for distributed tracing"
    },
    "causationId": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the event that caused this event"
    },
    "source": {
      "type": "string",
      "description": "Service/component that produced this event"
    },
    "data": {
      "type": "object",
      "description": "Event payload",
      "properties": {
        "{{fieldName}}": {
          "type": "{{fieldType}}",
          "description": "{{fieldDescription}}"
        }
      },
      "required": ["{{requiredFields}}"]
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User who triggered the event"
        },
        "tenantId": {
          "type": "string",
          "description": "Tenant identifier for multi-tenant systems"
        }
      }
    }
  }
}

# pnpm設定
enable-pre-post-scripts=true
build-from-source=true
side-effects-cache=false
# ネイティブモジュールは常にソースからビルド
native-modules-build-mode=always
# ビルドスクリプトブロックを無効化
ignore-dep-scripts=false
# GitHub CI環境でgit+ssh://をgit+https://に変換
git-url-rewrite=true

# electron-builder対応: isolated modeで完全なnode_modulesを各パッケージに作成
node-linker=isolated

# プロジェクト専用ストア（グローバルストアからの独立）
# これにより他プロジェクトや環境変更の影響を受けなくなる
store-dir=./.pnpm-store

# ネイティブモジュール（better-sqlite3等）の副作用キャッシュを無効化
# 常に現在のNode.jsバージョン用にビルドされることを保証
side-effects-cache-readonly=true

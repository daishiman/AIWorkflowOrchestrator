{
  "name": "ai-workflow-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Universal AI Workflow Orchestrator - Monorepo",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @repo/desktop dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "build": "pnpm --filter @repo/desktop build",
    "build:web": "pnpm --filter @repo/web build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r --parallel test:run",
    "test:watch": "vitest",
    "test:all": "pnpm -r --parallel test:run",
    "test:coverage": "pnpm -r --parallel test:coverage",
    "test:desktop": "pnpm --filter @repo/desktop test:run",
    "test:shared": "pnpm --filter @repo/shared test:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "typecheck:desktop": "pnpm --filter @repo/desktop typecheck",
    "typecheck:shared": "pnpm --filter @repo/shared typecheck",
    "validate": "run-p lint typecheck test",
    "validate:full": "pnpm lint && pnpm typecheck && pnpm test",
    "check:module-sync": "tsx scripts/check-shared-module-sync.ts",
    "check": "run-p lint typecheck",
    "clean": "pnpm -r exec rm -rf dist out node_modules/.vite",
    "prepare": "husky",
    "postinstall": "bash scripts/setup-native-modules.sh || pnpm rebuild better-sqlite3 || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/rollup-darwin-x64": "4.53.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.21.1 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "restore-cursor>signal-exit": "^3.0.7",
      "jsdom": "25.0.1"
    }
  },
  "volta": {
    "node": "22.21.1"
  }
}

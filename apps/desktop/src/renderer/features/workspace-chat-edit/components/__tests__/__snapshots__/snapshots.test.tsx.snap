exports[`Snapshot Tests > DiffEditor > sideBySide=falseのスナップショット 1`] = `
<div>
  <div
    aria-describedby="diff-editor-description"
    aria-label="差分エディタ"
    class="relative"
    role="region"
    style="height: 400px;"
  >
    <span
      class="sr-only"
      id="diff-editor-description"
    >
      左側に元のコード、右側に変更後のコードを表示しています
    </span>
    <div
      data-testid="monaco-diff-snapshot"
    >
      <span
        data-testid="original"
      >
        const x = 1;
      </span>
      <span
        data-testid="modified"
      >
        const x: number = 1;
      </span>
      <span
        data-testid="language"
      >
        typescript
      </span>
      <span
        data-testid="theme"
      >
        vs-dark
      </span>
    </div>
  </div>
</div>
`;


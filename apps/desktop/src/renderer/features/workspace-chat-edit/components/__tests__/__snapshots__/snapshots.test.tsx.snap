exports[`Snapshot Tests > EditCommandInput > size=sm のスナップショット 1`] = `
<div>
  <form
    aria-busy="false"
    class="flex flex-col gap-3"
    role="form"
  >
    <div
      class="flex items-center gap-2"
    >
      <select
        aria-label="コマンドタイプ"
        class="flex-1 rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed px-2 py-1 text-sm"
      >
        <option
          value="continue"
        >
          続きを書く
        </option>
        <option
          value="refactor"
        >
          リファクタリング
        </option>
        <option
          value="generate-test"
        >
          テスト生成
        </option>
        <option
          value="add-comment"
        >
          コメント追加
        </option>
        <option
          value="custom"
        >
          カスタム
        </option>
      </select>
    </div>
    <button
      aria-label="コマンドを実行"
      class="w-full rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center justify-center gap-2 px-3 py-1.5 text-sm"
      type="submit"
    >
      送信
    </button>
  </form>
</div>
`;


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Definition",
  "description": "Schema for task specification agent definition",
  "type": "object",
  "required": ["TASK_TITLE", "STEPS"],
  "properties": {
    "TASK_TITLE": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "description": "Task title"
    },
    "STEPS": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action"],
        "properties": {
          "step": { "type": "integer" },
          "action": { "type": "string" },
          "owner": {
            "type": "string",
            "enum": ["LLM", "Script", "User"]
          }
        }
      }
    },
    "INPUTS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "OUTPUTS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Response Template",
  "description": "HTTPベストプラクティスに準拠したAPIレスポンスの標準テンプレート",
  "type": "object",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "成功時のレスポンス形式（2xx系）",
      "type": "object",
      "properties": {
        "data": {
          "description": "レスポンスデータ（リソース本体）",
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "meta": {
          "description": "メタデータ（ページネーション、タイムスタンプ等）",
          "type": "object",
          "properties": {
            "timestamp": {
              "description": "レスポンス生成時刻（ISO 8601形式）",
              "type": "string",
              "format": "date-time",
              "example": "2025-12-31T12:00:00Z"
            },
            "requestId": {
              "description": "リクエストID（トレーシング用）",
              "type": "string",
              "example": "req_abc123def456"
            },
            "pagination": {
              "description": "ページネーション情報（リスト取得時）",
              "type": "object",
              "properties": {
                "page": {
                  "description": "現在のページ番号（1始まり）",
                  "type": "integer",
                  "minimum": 1,
                  "example": 1
                },
                "perPage": {
                  "description": "1ページあたりのアイテム数",
                  "type": "integer",
                  "minimum": 1,
                  "example": 20
                },
                "total": {
                  "description": "総アイテム数",
                  "type": "integer",
                  "minimum": 0,
                  "example": 100
                },
                "totalPages": {
                  "description": "総ページ数",
                  "type": "integer",
                  "minimum": 0,
                  "example": 5
                }
              },
              "required": ["page", "perPage", "total", "totalPages"]
            }
          }
        }
      },
      "required": ["data"],
      "example": {
        "data": {
          "id": "user_123",
          "name": "John Doe",
          "email": "john@example.com"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_abc123def456"
        }
      }
    },
    {
      "title": "Error Response",
      "description": "エラー時のレスポンス形式（4xx系、5xx系）",
      "type": "object",
      "properties": {
        "error": {
          "description": "エラー情報",
          "type": "object",
          "properties": {
            "code": {
              "description": "エラーコード（アプリケーション固有）",
              "type": "string",
              "pattern": "^[A-Z_]+$",
              "examples": [
                "INVALID_REQUEST",
                "RESOURCE_NOT_FOUND",
                "UNAUTHORIZED",
                "FORBIDDEN",
                "INTERNAL_SERVER_ERROR",
                "VALIDATION_ERROR",
                "RATE_LIMIT_EXCEEDED"
              ]
            },
            "message": {
              "description": "ユーザーフレンドリーなエラーメッセージ",
              "type": "string",
              "examples": [
                "The requested resource was not found.",
                "Invalid email format.",
                "You do not have permission to access this resource."
              ]
            },
            "details": {
              "description": "詳細なエラー情報（デバッグ用）",
              "type": ["object", "array", "string", "null"],
              "examples": [
                {
                  "field": "email",
                  "issue": "Invalid format",
                  "expected": "user@example.com"
                },
                [
                  "email field is required",
                  "password must be at least 8 characters"
                ]
              ]
            },
            "documentation": {
              "description": "エラー解決のためのドキュメントURL",
              "type": "string",
              "format": "uri",
              "example": "https://docs.example.com/errors/VALIDATION_ERROR"
            }
          },
          "required": ["code", "message"]
        },
        "meta": {
          "description": "メタデータ（タイムスタンプ、リクエストID等）",
          "type": "object",
          "properties": {
            "timestamp": {
              "description": "エラー発生時刻（ISO 8601形式）",
              "type": "string",
              "format": "date-time",
              "example": "2025-12-31T12:00:00Z"
            },
            "requestId": {
              "description": "リクエストID（トレーシング用）",
              "type": "string",
              "example": "req_abc123def456"
            }
          }
        }
      },
      "required": ["error"],
      "example": {
        "error": {
          "code": "VALIDATION_ERROR",
          "message": "The request contains invalid data.",
          "details": {
            "email": "Invalid email format. Expected format: user@example.com"
          },
          "documentation": "https://docs.example.com/errors/VALIDATION_ERROR"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_abc123def456"
        }
      }
    }
  ],
  "examples": [
    {
      "title": "GET /users/123 - 成功（200 OK）",
      "value": {
        "data": {
          "id": "user_123",
          "name": "John Doe",
          "email": "john@example.com",
          "createdAt": "2025-01-01T00:00:00Z",
          "updatedAt": "2025-12-31T12:00:00Z"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_abc123def456"
        }
      }
    },
    {
      "title": "GET /users - 成功（200 OK）with ページネーション",
      "value": {
        "data": [
          {
            "id": "user_123",
            "name": "John Doe",
            "email": "john@example.com"
          },
          {
            "id": "user_456",
            "name": "Jane Smith",
            "email": "jane@example.com"
          }
        ],
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_abc123def456",
          "pagination": {
            "page": 1,
            "perPage": 20,
            "total": 100,
            "totalPages": 5
          }
        }
      }
    },
    {
      "title": "POST /users - 作成成功（201 Created）",
      "value": {
        "data": {
          "id": "user_789",
          "name": "Bob Johnson",
          "email": "bob@example.com",
          "createdAt": "2025-12-31T12:00:00Z"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_ghi789jkl012"
        }
      }
    },
    {
      "title": "DELETE /users/123 - 削除成功（204 No Content）",
      "description": "204 No Contentの場合はレスポンスボディなし",
      "value": null
    },
    {
      "title": "GET /users/999 - リソース不在（404 Not Found）",
      "value": {
        "error": {
          "code": "RESOURCE_NOT_FOUND",
          "message": "The requested user was not found.",
          "details": {
            "resourceType": "User",
            "resourceId": "999"
          },
          "documentation": "https://docs.example.com/errors/RESOURCE_NOT_FOUND"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_mno345pqr678"
        }
      }
    },
    {
      "title": "POST /users - バリデーションエラー（400 Bad Request）",
      "value": {
        "error": {
          "code": "VALIDATION_ERROR",
          "message": "The request contains invalid data.",
          "details": {
            "email": "Invalid email format. Expected format: user@example.com",
            "password": "Password must be at least 8 characters long."
          },
          "documentation": "https://docs.example.com/errors/VALIDATION_ERROR"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_stu901vwx234"
        }
      }
    },
    {
      "title": "GET /admin/users - 認証エラー（401 Unauthorized）",
      "value": {
        "error": {
          "code": "UNAUTHORIZED",
          "message": "Authentication is required to access this resource.",
          "details": {
            "reason": "Missing or invalid authentication token."
          },
          "documentation": "https://docs.example.com/errors/UNAUTHORIZED"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_yza567bcd890"
        }
      }
    },
    {
      "title": "DELETE /users/123 - 認可エラー（403 Forbidden）",
      "value": {
        "error": {
          "code": "FORBIDDEN",
          "message": "You do not have permission to perform this action.",
          "details": {
            "reason": "Insufficient privileges. Admin role required."
          },
          "documentation": "https://docs.example.com/errors/FORBIDDEN"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_efg123hij456"
        }
      }
    },
    {
      "title": "GET /users - レート制限エラー（429 Too Many Requests）",
      "value": {
        "error": {
          "code": "RATE_LIMIT_EXCEEDED",
          "message": "Too many requests. Please try again later.",
          "details": {
            "limit": 100,
            "remaining": 0,
            "resetAt": "2025-12-31T13:00:00Z"
          },
          "documentation": "https://docs.example.com/errors/RATE_LIMIT_EXCEEDED"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_klm789nop012"
        }
      }
    },
    {
      "title": "POST /users - サーバーエラー（500 Internal Server Error）",
      "value": {
        "error": {
          "code": "INTERNAL_SERVER_ERROR",
          "message": "An unexpected error occurred. Please try again later.",
          "details": "Contact support with request ID if the issue persists.",
          "documentation": "https://docs.example.com/errors/INTERNAL_SERVER_ERROR"
        },
        "meta": {
          "timestamp": "2025-12-31T12:00:00Z",
          "requestId": "req_qrs345tuv678"
        }
      }
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "{スキーマタイトル}",
  "description": "{スキーマの説明}",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "description": "一意識別子"
    },
    "name": {
      "type": "string",
      "description": "名前",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "description": "説明（オプション）"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "pending"],
      "default": "pending"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
